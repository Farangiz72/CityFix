# Скопируйте этот файл в .env и заполните значения.
# Copy this file to .env and fill in the values. .env is never committed.
#
# База данных — файл SQLite внутри контейнера API, отдельный сервер БД не нужен.
# The database is a SQLite file inside the API container, no separate DB server is required.

# --- Безопасность / Security ---
# Секрет подписи JWT (обязателен, не короче 32 символов)
# JWT signing secret (required, at least 32 characters)
JWT_SECRET=change-me-please-32-characters-minimum
JWT_EXPIRES_IN=12h

# --- Файлы / Uploads ---
# Максимальный размер фото, МБ / max photo size in MB
MAX_UPLOAD_MB=5

# --- Инициализация данных / Seeding ---
# Создать тестовые логины и демонстрационные заявки при старте
# Create test logins and demo requests on start
SEED_ON_START=true
# Сколько записей генерировать для проверки NFR-1 (TC-9)
# How many filler records to generate for the NFR-1 check (TC-9)
SEED_DEMO_REQUESTS=1000

# --- Прочее / Misc ---
# Разрешённый origin для CORS ('*' для учебного стенда)
CORS_ORIGIN=*
