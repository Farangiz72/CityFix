# Локальный запуск API без Docker / local API run without Docker
# Скопируйте в backend/.env: база — файл SQLite внутри проекта, сервер БД не нужен.
# Copy to backend/.env: the database is a SQLite file inside the project, no DB server needed.
# Путь к SQLite-файлу. Указывайте АБСОЛЮТНЫЙ путь: CLI Prisma и сервер считают
# относительные пути от разных каталогов. Если переменную не задать, сервер сам
# возьмёт backend/data/cityfix.db (см. src/prisma.ts), но CLI она нужна.
# Use an ABSOLUTE path: the Prisma CLI and the server resolve relative paths differently.
DATABASE_URL=file:C:/path/to/CityFix/backend/data/cityfix.db
JWT_SECRET=change-me-please-32-characters-minimum
JWT_EXPIRES_IN=12h
PORT=4000
MAX_UPLOAD_MB=5
UPLOAD_DIR=uploads
SEED_DEMO_REQUESTS=1000
CORS_ORIGIN=*
